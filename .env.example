# ChainPulse configuration
# Paper/sim is the default. No Binance API secret keys — Agent OS uses OAuth / App confirmations.

# Mode: paper | mock | live (live requires Agentic Hub / OAuth MCP; still needs confirmations)
CHAINPULSE_MODE=paper

# Binance Wallet Agentic Hub (BAW / on-chain) — primary rail for ChainPulse
BINANCE_BAW_HUB_URL=https://web3.binance.com/agentic-hub

# Optional MCP (CEX context: prices / account hints)
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_AGENT_OS_OAUTH_CLIENT_ID=grok

# Risk limits (workflow-level)
MAX_NOTIONAL_PER_STEP_USD=5000
MAX_STEPS_PER_DAY=40
KILL_SWITCH=false
REQUIRE_WORKFLOW_CONFIRM=true

# Paper wallet seed (not live funds)
PAPER_ETH=5
PAPER_USDT=25000
PAPER_BNB=10
PAPER_STETH=0
