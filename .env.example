# ChainPulse — LIVE-first. Paper only as an explicit offline escape hatch.
# No Binance API secret keys — Agent OS uses baw auth / App confirmations.

# Mode: live (default) | paper | mock
# Paper only when you set CHAINPULSE_MODE=paper explicitly.
CHAINPULSE_MODE=live

# Optional: path to baw CLI (default ~/.local/bin/baw)
# BAW_BIN=/home/box/.local/bin/baw

# Live mutate (demo): set LIVE_MUTATE=1 to also swap / Lista Earn deposit
# LIVE_MUTATE=0
# LIVE_QUOTE_USDT=1
# LIVE_DEPOSIT_USDT=1
# LISTA_USDT_INVESTMENT_ID=375fd88612886bb87df0053fa1de8574f0f5ada1b92b7d52a34a34de94f683e7

# Binance Wallet Agentic Hub (reference URL)
BINANCE_BAW_HUB_URL=https://web3.binance.com/agentic-hub

# Optional MCP (CEX context)
BINANCE_AGENT_OS_MCP_URL=https://agent.binance.com/mcp/agentic
BINANCE_AGENT_OS_OAUTH_CLIENT_ID=grok

# Risk limits (workflow-level)
MAX_NOTIONAL_PER_STEP_USD=5000
MAX_STEPS_PER_DAY=40
KILL_SWITCH=false
REQUIRE_WORKFLOW_CONFIRM=true

# Paper wallet seed (only when CHAINPULSE_MODE=paper)
PAPER_ETH=5
PAPER_USDT=25000
PAPER_BNB=10
PAPER_STETH=0
